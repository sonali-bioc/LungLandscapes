{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "2f3024ae",
   "metadata": {},
   "source": [
    "# Simple PaCMAP fit + transform\n",
    "\n",
    "Minimal landing example: fit PaCMAP on a reference cohort, transform new samples into that\n",
    "space, plot the reference landscape vs. the landed points, and save the landed\n",
    "coordinates to CSV."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Install dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b96e89c0",
   "metadata": {},
   "outputs": [],
   "source": [
    "%pip install -q pacmap pandas numpy matplotlib"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pacmap"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Inputs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [],
   "source": [
    "# CSV of the reference cohort: rows = samples, columns = genes, first column = sample ID.\n",
    "# Must already be batch-corrected and VST-normalized.\n",
    "# First column/index must be gene names. Other columns are sample IDs\n",
    "TRAINING_VST_COUNTS = r\"data\\VST_counts.txt\"\n",
    "\n",
    "# CSV of the new sample(s) to land, same gene set / normalization as training data. No batch correction.\n",
    "# First column/index must be gene names. Other columns are sample IDs\n",
    "NEW_VST_COUNTS_TO_LAND = r\"data\\pdx_43_small_cell_no_hg38_vst_protein_coding_genes.txt\"\n",
    "\n",
    "# Path to write the landed coordinates.\n",
    "OUTPUT_CSV_PATH = \"pacmap_landed_coordinates.csv\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training data: 1824 samples, 19055 features\n",
      "Landing data: 42 samples, 19055 features\n"
     ]
    }
   ],
   "source": [
    "X_train = pd.read_csv(TRAINING_VST_COUNTS, sep=DELIMITER, index_col=0)\n",
    "X_test = pd.read_csv(NEW_VST_COUNTS_TO_LAND, sep=DELIMITER, index_col=0)\n",
    "\n",
    "X_test_sample_ids = X_test.columns\n",
    "\n",
    "assert X_train.index.equals(X_test.index), \"Genes do not match between training and new data. Check that both datasets have the same genes in the same order.\"\n",
    "\n",
    "X_train = X_train.T.to_numpy(dtype=np.float32)\n",
    "X_test = X_test.T.to_numpy(dtype=np.float32)\n",
    "\n",
    "train_samples, train_features = X_train.shape\n",
    "test_samples, test_features = X_test.shape\n",
    "\n",
    "print(f\"Training data: {train_samples} samples, {train_features} features\")\n",
    "print(f\"Landing data: {test_samples} samples, {test_features} features\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Fit PaCMAP on the reference cohort"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Warning: random state is set to 42.\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training embedding shape: (1824, 2)\n"
     ]
    }
   ],
   "source": [
    "reducer = pacmap.PaCMAP(\n",
    "    n_components=2,     # output dimensionality (2D landscape)\n",
    "    n_neighbors=30,      # number of neighbors considered per point; None = auto-scaled by sample size\n",
    "    MN_ratio=0.25,        # ratio of mid-near pairs to neighbor pairs; controls global structure\n",
    "    FP_ratio=3.0,        # ratio of further pairs to neighbor pairs; controls separation between clusters\n",
    "    random_state=42,      # seed for reproducibility\n",
    ")\n",
    "\n",
    "# fit_transform embeds the training data and stores what's needed for later .transform() calls\n",
    "# this is the \"reference landscape\"\n",
    "train_embedding = reducer.fit_transform(X_train)\n",
    "\n",
    "train_embedding.shape\n",
    "print(f\"Training embedding shape: {train_embedding.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Transform new samples into the fitted landscape"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(42, 2)"
      ]
     },
     "execution_count": 40,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# basis=X_train tells PaCMAP to place new points relative to the original training data\n",
    "landed_coordinates = reducer.transform(X_test, basis=X_train)\n",
    "\n",
    "landed_coordinates.shape"
   ]
  }
 ]
}
